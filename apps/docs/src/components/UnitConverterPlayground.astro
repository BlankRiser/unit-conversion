---
import { CONVERSION_FACTORS, LABELS, UNITS } from "@devhaven/unit-conversion";

const categoryMeta: Record<string, { label: string; description: string }> = {
  length: {
    label: "Length",
    description:
      "SI metric and Imperial/US distance measurements (base: meter)",
  },
  temperature: {
    label: "Temperature",
    description: "Thermodynamic temperature scales (base: kelvin)",
  },
  weight: {
    label: "Weight",
    description: "Metric and Imperial mass/weight units (base: gram)",
  },
  volume: {
    label: "Volume",
    description: "Liquid and cubic volume measurements (base: liter)",
  },
  time: {
    label: "Time",
    description: "Duration units from milliseconds to weeks (base: second)",
  },
  number: {
    label: "Number",
    description: "Radix / number base conversions (base: decimal)",
  },
  pressure: {
    label: "Pressure",
    description: "Force per unit area measurements (base: pascal)",
  },
  energy: {
    label: "Energy",
    description: "Work, heat, and electrical energy units (base: joule)",
  },
  force: {
    label: "Force",
    description: "Mechanical force units (base: newton)",
  },
};

// Build list of active categories and their supported units
const categories = Object.keys(UNITS)
  .filter((cat) => cat in CONVERSION_FACTORS)
  .map((cat) => {
    const rawUnits = UNITS[cat as keyof typeof UNITS] as string[];
    const factorMap = CONVERSION_FACTORS[cat] ?? {};
    const supportedUnits = rawUnits.filter((u) => u in factorMap);
    return {
      id: cat,
      label:
        categoryMeta[cat]?.label ?? cat.charAt(0).toUpperCase() + cat.slice(1),
      description: categoryMeta[cat]?.description ?? "",
      units: supportedUnits.map((u) => ({
        id: u,
        symbol: LABELS[u as keyof typeof LABELS] ?? u,
      })),
    };
  })
  .filter((c) => c.units.length > 0);

const locales = [
  { value: "", label: "None (Default)" },
  { value: "en-US", label: "en-US — English (US)" },
  { value: "en-GB", label: "en-GB — English (UK)" },
  { value: "de-DE", label: "de-DE — German (Germany)" },
  { value: "fr-FR", label: "fr-FR — French (France)" },
  { value: "hi-IN", label: "hi-IN — Hindi (India)" },
  { value: "ar-EG", label: "ar-EG — Arabic (Egypt)" },
  { value: "ru-RU", label: "ru-RU — Russian (Russia)" },
  { value: "ja-JP", label: "ja-JP — Japanese (Japan)" },
  { value: "zh-CN", label: "zh-CN — Chinese (China)" },
  { value: "pt-BR", label: "pt-BR — Portuguese (Brazil)" },
];
---

<div
  class="uc-playground not-content"
  data-categories={JSON.stringify(categories)}
>
  <!-- Category Selector Tabs -->
  <div class="uc-section">
    <div class="uc-section-header">
      <span class="uc-section-label">1. Select Category</span>
      <span class="uc-category-desc" id="uc-category-desc"
        >{categories[0]?.description}</span
      >
    </div>
    <div class="uc-category-tabs" role="tablist" aria-label="Unit Categories">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            role="tab"
            class:list={["uc-tab", { active: idx === 0 }]}
            aria-selected={idx === 0 ? "true" : "false"}
            data-category={cat.id}
          >
            <span class="uc-tab-name">{cat.label}</span>
            <span class="uc-tab-count">{cat.units.length}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Main Conversion Controls -->
  <div class="uc-converter-grid">
    <div class="uc-panel uc-inputs-panel">
      <div class="uc-panel-header">
        <span class="uc-section-label">2. Conversion Input</span>
        <div
          class="uc-presets"
          id="uc-presets"
          aria-label="Quick preset values"
        >
        </div>
      </div>

      <div class="uc-field">
        <label for="uc-value-input" class="uc-label">Value to convert</label>
        <div class="uc-input-wrap">
          <input
            id="uc-value-input"
            type="text"
            inputmode="decimal"
            value="100"
            placeholder="Enter a number..."
            class="uc-input"
            autocomplete="off"
          />
          <span class="uc-input-unit-badge" id="uc-input-unit-badge">m</span>
        </div>
      </div>

      <div class="uc-unit-selectors">
        <div class="uc-field">
          <label for="uc-from-select" class="uc-label">From Unit</label>
          <select id="uc-from-select" class="uc-select"></select>
        </div>

        <button
          type="button"
          id="uc-swap-btn"
          class="uc-swap-btn"
          title="Swap From and To units"
          aria-label="Swap From and To units"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 16V4M7 4L3 8M7 4L11 8"></path>
            <path d="M17 8v12m0 0 4-4m-4 4-4-4"></path>
          </svg>
        </button>

        <div class="uc-field">
          <label for="uc-to-select" class="uc-label">To Unit</label>
          <select id="uc-to-select" class="uc-select"></select>
        </div>
      </div>

      <!-- Result Banner -->
      <div class="uc-result-box" id="uc-result-box" aria-live="polite">
        <div class="uc-result-top">
          <span class="uc-result-caption" id="uc-result-formula"
            >100 meter → kilometer</span
          >
          <span class="uc-type-pill" id="uc-result-type">number</span>
        </div>
        <div class="uc-result-main">
          <span class="uc-result-value" id="uc-result-value">0.1</span>
          <span class="uc-result-unit" id="uc-result-unit">km</span>
        </div>
        <div class="uc-result-raw">
          <code id="uc-result-json">{`{ value: 0.1, unit: "km" }`}</code>
        </div>
        <div class="uc-error-message" id="uc-error-message" hidden></div>
      </div>
    </div>

    <!-- Config Options & Live Code -->
    <div class="uc-panel uc-config-panel">
      <div class="uc-panel-header">
        <span class="uc-section-label">3. Configuration Options</span>
        <button type="button" id="uc-reset-config" class="uc-text-btn"
          >Reset defaults</button
        >
      </div>

      <div class="uc-config-controls">
        <div class="uc-config-row">
          <div class="uc-config-info">
            <label for="uc-is-float" class="uc-label"
              >Floating-point (<code>isFloat</code>)</label
            >
            <span class="uc-hint"
              >When disabled, rounds result with <code>Math.round()</code></span
            >
          </div>
          <input id="uc-is-float" type="checkbox" checked class="uc-checkbox" />
        </div>

        <div class="uc-config-row" id="uc-decimals-row">
          <div class="uc-config-info">
            <label for="uc-decimals" class="uc-label">
              Decimal places (<code>decimals</code>): <strong
                id="uc-decimals-val">2</strong
              >
            </label>
            <span class="uc-hint"
              >Precision between 0 and 20 decimal places</span
            >
          </div>
          <div class="uc-decimals-inputs">
            <input
              id="uc-decimals"
              type="range"
              min="0"
              max="12"
              step="1"
              value="2"
              class="uc-range"
            />
            <input
              id="uc-decimals-num"
              type="number"
              min="0"
              max="20"
              step="1"
              value="2"
              class="uc-number-mini"
              aria-label="Decimal places number"
            />
          </div>
        </div>

        <div class="uc-config-row uc-config-col">
          <div class="uc-config-info">
            <label for="uc-locale" class="uc-label"
              >Locale formatting (<code>locale</code>)</label
            >
            <span class="uc-hint"
              >Formats numeric output via <code>toLocaleString(locale)</code
              ></span
            >
          </div>
          <select id="uc-locale" class="uc-select">
            {
              locales.map((loc) => (
                <option value={loc.value}>{loc.label}</option>
              ))
            }
          </select>
        </div>
      </div>

      <!-- Live Code Preview -->
      <div class="uc-code-block">
        <div class="uc-code-header">
          <span class="uc-code-title">TypeScript Usage</span>
          <button type="button" id="uc-copy-code" class="uc-copy-btn"
            >Copy code</button
          >
        </div>
        <pre class="uc-pre"><code id="uc-code-preview" /></pre>
      </div>
    </div>
  </div>

  <!-- All Units in Category Table -->
  <div class="uc-section uc-all-units-section">
    <div class="uc-section-header">
      <div>
        <span class="uc-section-label" id="uc-table-title"
          >All Length Conversions</span
        >
        <p class="uc-table-subtitle">
          Showing live conversions from <strong id="uc-table-from-summary"
            >100 meter</strong
          > to every unit in this category. Click any row to set it as the target
          unit.
        </p>
      </div>
    </div>

    <div class="uc-table-wrap">
      <table class="uc-table">
        <thead>
          <tr>
            <th>Target Unit</th>
            <th>Label / Symbol</th>
            <th>Converted Value</th>
            <th>Return Object</th>
          </tr>
        </thead>
        <tbody id="uc-all-units-body"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { Conversion, type AllUnits } from "@devhaven/unit-conversion";

  interface UnitInfo {
    id: string;
    symbol: string;
  }

  interface CategoryInfo {
    id: string;
    label: string;
    description: string;
    units: UnitInfo[];
  }

  const categoryPresets: Record<string, string[]> = {
    length: ["1", "10", "100", "1000", "5280"],
    temperature: ["-40", "0", "37", "100", "273.15"],
    weight: ["1", "16", "100", "453.592", "1000"],
    volume: ["1", "10", "250", "1000"],
    time: ["1", "60", "3600", "86400"],
    number: ["0", "10", "42", "255", "1010"],
    pressure: ["1", "14.696", "100", "101325"],
    energy: ["1", "100", "1000", "3600"],
    force: ["1", "9.80665", "100", "1000"],
  };

  function formatUnitName(unitId: string): string {
    if (unitId === "base8") return "Octal (base8)";
    if (unitId === "psi") return "PSI (psi)";
    return unitId
      .split("-")
      .map((part) =>
        part === "us"
          ? "US"
          : part === "uk"
            ? "UK"
            : part.charAt(0).toUpperCase() + part.slice(1),
      )
      .join(" ");
  }

  function initPlayground() {
    const root = document.querySelector(".uc-playground") as HTMLElement | null;
    if (!root) return;

    const categories: CategoryInfo[] = JSON.parse(
      root.dataset.categories || "[]",
    );
    if (!categories.length) return;

    const tabButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".uc-tab"),
    );
    const categoryDescEl = document.getElementById("uc-category-desc")!;
    const presetsContainer = document.getElementById("uc-presets")!;
    const valueInput = document.getElementById(
      "uc-value-input",
    ) as HTMLInputElement;
    const inputUnitBadge = document.getElementById("uc-input-unit-badge")!;
    const fromSelect = document.getElementById(
      "uc-from-select",
    ) as HTMLSelectElement;
    const toSelect = document.getElementById(
      "uc-to-select",
    ) as HTMLSelectElement;
    const swapBtn = document.getElementById("uc-swap-btn") as HTMLButtonElement;

    const resultBox = document.getElementById("uc-result-box")!;
    const resultFormula = document.getElementById("uc-result-formula")!;
    const resultType = document.getElementById("uc-result-type")!;
    const resultValue = document.getElementById("uc-result-value")!;
    const resultUnit = document.getElementById("uc-result-unit")!;
    const resultJson = document.getElementById("uc-result-json")!;
    const errorMessage = document.getElementById("uc-error-message")!;

    const isFloatInput = document.getElementById(
      "uc-is-float",
    ) as HTMLInputElement;
    const decimalsRange = document.getElementById(
      "uc-decimals",
    ) as HTMLInputElement;
    const decimalsNum = document.getElementById(
      "uc-decimals-num",
    ) as HTMLInputElement;
    const decimalsVal = document.getElementById("uc-decimals-val")!;
    const decimalsRow = document.getElementById("uc-decimals-row")!;
    const localeSelect = document.getElementById(
      "uc-locale",
    ) as HTMLSelectElement;
    const resetConfigBtn = document.getElementById(
      "uc-reset-config",
    ) as HTMLButtonElement;

    const codePreview = document.getElementById("uc-code-preview")!;
    const copyCodeBtn = document.getElementById(
      "uc-copy-code",
    ) as HTMLButtonElement;

    const tableTitle = document.getElementById("uc-table-title")!;
    const tableFromSummary = document.getElementById("uc-table-from-summary")!;
    const allUnitsBody = document.getElementById("uc-all-units-body")!;

    let activeCategory = categories[0];

    function renderPresets() {
      const presets = categoryPresets[activeCategory.id] ?? ["1", "10", "100"];
      presetsContainer.innerHTML = "";
      for (const preset of presets) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "uc-preset-btn";
        btn.textContent = preset;
        btn.addEventListener("click", () => {
          valueInput.value = preset;
          updateConversion();
        });
        presetsContainer.appendChild(btn);
      }
    }

    function populateUnitSelects() {
      fromSelect.innerHTML = "";
      toSelect.innerHTML = "";

      activeCategory.units.forEach((u) => {
        const label =
          activeCategory.id === "number"
            ? `${formatUnitName(u.id)}`
            : `${formatUnitName(u.id)} (${u.symbol})`;

        const optFrom = document.createElement("option");
        optFrom.value = u.id;
        optFrom.textContent = label;
        fromSelect.appendChild(optFrom);

        const optTo = document.createElement("option");
        optTo.value = u.id;
        optTo.textContent = label;
        toSelect.appendChild(optTo);
      });

      if (activeCategory.units.length > 1) {
        fromSelect.value = activeCategory.units[0].id;
        toSelect.value = activeCategory.units[1].id;
      } else if (activeCategory.units.length === 1) {
        fromSelect.value = activeCategory.units[0].id;
        toSelect.value = activeCategory.units[0].id;
      }
    }

    function getConfig() {
      const isFloat = isFloatInput.checked;
      const decimals = Number.parseInt(decimalsNum.value, 10);
      const locale = localeSelect.value || undefined;
      return {
        isFloat,
        decimals: Number.isNaN(decimals)
          ? 2
          : Math.max(0, Math.min(20, decimals)),
        locale,
      };
    }

    function parseInputValue(raw: string): number | string {
      const trimmed = raw.trim();
      if (trimmed === "") return NaN;
      const asNum = Number(trimmed);
      if (!Number.isNaN(asNum)) {
        return asNum;
      }
      return trimmed;
    }

    function buildCodeSnippet(
      inputVal: number | string,
      fromUnit: string,
      toUnit: string,
      config: { isFloat: boolean; decimals: number; locale?: string },
      outputComment: string,
    ) {
      const configParts: string[] = [];
      if (config.isFloat !== true) {
        configParts.push(`isFloat: false`);
      }
      if (config.decimals !== 2 && config.isFloat) {
        configParts.push(`decimals: ${config.decimals}`);
      }
      if (config.locale) {
        configParts.push(`locale: "${config.locale}"`);
      }

      const configArg =
        configParts.length > 0 ? `{ ${configParts.join(", ")} }` : "";
      const formattedInput =
        typeof inputVal === "number" && !Number.isNaN(inputVal)
          ? String(inputVal)
          : JSON.stringify(String(inputVal));

      return [
        `import { Conversion } from "@devhaven/unit-conversion";`,
        ``,
        `const convert = new Conversion(${configArg});`,
        `const result = convert(${formattedInput}).from("${fromUnit}").to("${toUnit}");`,
        outputComment,
      ].join("\n");
    }

    function updateConversion() {
      const config = getConfig();
      decimalsRow.classList.toggle("is-disabled", !config.isFloat);
      decimalsRange.disabled = !config.isFloat;
      decimalsNum.disabled = !config.isFloat;

      const fromUnit = fromSelect.value as AllUnits;
      const toUnit = toSelect.value as AllUnits;
      const fromUnitObj = activeCategory.units.find((u) => u.id === fromUnit);
      inputUnitBadge.textContent =
        activeCategory.id === "number"
          ? fromUnit
          : (fromUnitObj?.symbol ?? fromUnit);

      const rawValue = valueInput.value;
      const parsedValue = parseInputValue(rawValue);

      const convert = new Conversion(config);
      const runConvert = (val: number | string) =>
        typeof convert === "function" ? convert(val) : convert.value(val);

      resultFormula.textContent = `${rawValue.trim() || "?"} ${fromUnit} → ${toUnit}`;
      tableTitle.textContent = `All ${activeCategory.label} Conversions`;
      tableFromSummary.textContent = `${rawValue.trim() || "?"} ${fromUnit}`;

      // Primary conversion
      try {
        if (rawValue.trim() === "") {
          throw new Error("Please enter a value to convert.");
        }
        const res = runConvert(parsedValue)
          .from(fromUnit)
          .to(toUnit as never);
        resultBox.classList.remove("has-error");
        errorMessage.hidden = true;
        resultValue.textContent = String(res.value);
        resultUnit.textContent =
          activeCategory.id === "number" ? `(${toUnit})` : res.unit;
        resultType.textContent = typeof res.value;

        const jsonStr = `{ value: ${JSON.stringify(res.value)}, unit: ${JSON.stringify(res.unit)} }`;
        resultJson.textContent = jsonStr;

        codePreview.textContent = buildCodeSnippet(
          parsedValue,
          fromUnit,
          toUnit,
          config,
          `// => ${jsonStr}`,
        );
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        resultBox.classList.add("has-error");
        errorMessage.hidden = false;
        errorMessage.textContent = msg;
        resultValue.textContent = "—";
        resultUnit.textContent = "";
        resultType.textContent = "error";
        resultJson.textContent = `Error: ${msg}`;

        codePreview.textContent = buildCodeSnippet(
          rawValue.trim(),
          fromUnit,
          toUnit,
          config,
          `// Throws Error: ${msg}`,
        );
      }

      // All units table
      allUnitsBody.innerHTML = "";
      for (const target of activeCategory.units) {
        const tr = document.createElement("tr");
        tr.className = "uc-table-row";
        if (target.id === toUnit) {
          tr.classList.add("is-selected");
        }
        tr.addEventListener("click", () => {
          toSelect.value = target.id;
          updateConversion();
        });

        const tdName = document.createElement("td");
        tdName.className = "uc-td-unit";
        const nameSpan = document.createElement("span");
        nameSpan.className = "uc-unit-name";
        nameSpan.textContent = formatUnitName(target.id);
        const codeId = document.createElement("code");
        codeId.className = "uc-unit-id";
        codeId.textContent = `"${target.id}"`;
        tdName.append(nameSpan, codeId);

        const tdSymbol = document.createElement("td");
        const symCode = document.createElement("code");
        symCode.textContent = target.symbol;
        tdSymbol.appendChild(symCode);

        const tdVal = document.createElement("td");
        tdVal.className = "uc-td-value";

        const tdObj = document.createElement("td");
        tdObj.className = "uc-td-obj";

        try {
          if (rawValue.trim() === "") {
            throw new Error("Empty input");
          }
          const r = runConvert(parsedValue)
            .from(fromUnit)
            .to(target.id as never);
          const strong = document.createElement("strong");
          strong.textContent = String(r.value);
          const unitSub = document.createElement("span");
          unitSub.className = "uc-td-unit-suffix";
          unitSub.textContent =
            activeCategory.id === "number" ? "" : ` ${r.unit}`;
          tdVal.append(strong, unitSub);

          const objCode = document.createElement("code");
          objCode.textContent = `{ value: ${JSON.stringify(r.value)}, unit: ${JSON.stringify(r.unit)} }`;
          tdObj.appendChild(objCode);
        } catch (err) {
          const errSpan = document.createElement("span");
          errSpan.className = "uc-td-err";
          errSpan.textContent =
            err instanceof Error ? err.message : "Invalid input";
          tdVal.appendChild(errSpan);

          const dash = document.createElement("span");
          dash.className = "uc-td-err";
          dash.textContent = "—";
          tdObj.appendChild(dash);
        }

        tr.append(tdName, tdSymbol, tdVal, tdObj);
        allUnitsBody.appendChild(tr);
      }
    }

    // Event listeners
    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const catId = btn.dataset.category;
        const found = categories.find((c) => c.id === catId);
        if (!found) return;

        activeCategory = found;
        tabButtons.forEach((b) => {
          const isCurrent = b === btn;
          b.classList.toggle("active", isCurrent);
          b.setAttribute("aria-selected", isCurrent ? "true" : "false");
        });

        categoryDescEl.textContent = activeCategory.description;

        // Pick a sensible default value for the category
        if (activeCategory.id === "number") {
          valueInput.value = "10";
        } else if (activeCategory.id === "temperature") {
          valueInput.value = "100";
        } else {
          valueInput.value = "1";
        }

        renderPresets();
        populateUnitSelects();
        updateConversion();
      });
    });

    valueInput.addEventListener("input", updateConversion);
    fromSelect.addEventListener("change", updateConversion);
    toSelect.addEventListener("change", updateConversion);

    swapBtn.addEventListener("click", () => {
      const prevFrom = fromSelect.value;
      fromSelect.value = toSelect.value;
      toSelect.value = prevFrom;
      updateConversion();
    });

    isFloatInput.addEventListener("change", updateConversion);

    decimalsRange.addEventListener("input", () => {
      decimalsNum.value = decimalsRange.value;
      decimalsVal.textContent = decimalsRange.value;
      updateConversion();
    });

    decimalsNum.addEventListener("input", () => {
      const n = Math.max(
        0,
        Math.min(20, Number.parseInt(decimalsNum.value || "0", 10)),
      );
      decimalsRange.value = String(Math.min(12, n));
      decimalsVal.textContent = String(Number.isNaN(n) ? 2 : n);
      updateConversion();
    });

    localeSelect.addEventListener("change", updateConversion);

    resetConfigBtn.addEventListener("click", () => {
      isFloatInput.checked = true;
      decimalsRange.value = "2";
      decimalsNum.value = "2";
      decimalsVal.textContent = "2";
      localeSelect.value = "";
      updateConversion();
    });

    copyCodeBtn.addEventListener("click", async () => {
      const code = codePreview.textContent || "";
      try {
        await navigator.clipboard.writeText(code);
        const orig = copyCodeBtn.textContent;
        copyCodeBtn.textContent = "Copied!";
        setTimeout(() => {
          copyCodeBtn.textContent = orig;
        }, 1500);
      } catch {
        // Fallback ignored if clipboard unavailable
      }
    });

    // Initial render
    renderPresets();
    populateUnitSelects();
    updateConversion();
  }

  initPlayground();
  document.addEventListener("astro:page-load", initPlayground);
</script>

<style>
  .uc-playground {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-block: 1rem 2rem;
    color: var(--sl-color-text);
    font-family: var(--sl-font);
  }

  .uc-section,
  .uc-panel {
    background-color: var(--sl-rapide-ui-bg-color, var(--sl-color-gray-7));
    border: 1px solid var(--sl-rapide-ui-border-color, var(--sl-color-gray-5));
    border-radius: 0.5rem;
    padding: 1.25rem;
  }

  .uc-section-header,
  .uc-panel-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .uc-section-label {
